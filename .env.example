# ClassConnect — environment template.
#
# NFR-SEC-007: secrets live in a managed secret store, never in source control.
# This file documents the required variables; it must contain no real secret.
# Copy to .env for local development only.

NODE_ENV=development

# --- Database (§2.4: PostgreSQL 15+) -----------------------------------------
# Managed PostgreSQL (Neon, Supabase or Vercel Postgres). Raise connect_timeout
# above Prisma's 5s default: serverless Postgres scales compute to zero when idle
# and a cold start regularly exceeds it, which otherwise stops the API booting.
#
# DATABASE_URL must be the POOLED connection. Every serverless instance opens its
# own connections, and without a pooler a platform that scales out will exhaust
# the database's connection limit. On Neon that is the `-pooler` host; on
# Supabase, port 6543; on Vercel Postgres, the URL ending `-pooler`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&connect_timeout=30&pool_timeout=30

# DIRECT_DATABASE_URL is the same database WITHOUT the pooler. `prisma migrate`
# takes an advisory lock and runs DDL, and neither survives a transaction-mode
# pooler. Prisma requires this whenever the schema declares `directUrl`, so it
# must be set even locally — there, to the same value as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connect_timeout=30

# Local alternative — `npm run db:local` (real PostgreSQL, no Docker, no install):
# DATABASE_URL=postgresql://classconnect:classconnect_dev@localhost:5433/classconnect?schema=public
# DIRECT_DATABASE_URL=postgresql://classconnect:classconnect_dev@localhost:5433/classconnect?schema=public

# --- API ---------------------------------------------------------------------
# API_PORT is ignored on Vercel: the platform owns the socket and invokes the
# handler in apps/api/api/index.ts directly.
API_PORT=4000
# COM-002: the public API is versioned by URL path prefix.
API_PREFIX=/api/v1
# COM-001 / NFR-SEC-006: the exact origin(s) the browser may call the API from.
# Comma-separated. Deployed, this must be the real web origin — boot refuses if
# it is missing or still points at localhost.
WEB_ORIGIN=http://localhost:3000

# --- Scheduled work (§5.3) ---------------------------------------------------
# The daily billing pass — instalment notices at 7/3/1/0 days and the automatic
# freeze after grace — runs on a timer when the API is a long-running process,
# and from Vercel Cron when it is not. Cron sends this as a bearer token, and
# the endpoint refuses without it: unauthenticated, it would let anyone on the
# internet freeze learner accounts.
#
# Set the SAME value in the Vercel project settings, where it also makes Vercel
# attach the header automatically.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace-me-with-a-32-byte-random-value

# --- Tokens (FR-AUT-006) -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-value
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-value

# --- Application-layer encryption (NFR-SEC-003) ------------------------------
# Identity documents, payout details and safeguarding reports are encrypted with
# a key separate from the database credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# --- Object storage / CDN (SI-006) -------------------------------------------
# The API key must hold the `create` and `read` actions on the product
# environment, or every upload is refused with "missing permissions".
# The upload preset must exist and be in Signed mode — the server signs each
# upload against a narrow parameter allow-list.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=classconnect
# FR-FIL-003: how long a signed read URL stays valid.
FILE_SIGNED_URL_TTL_SECONDS=300

# FR-FIL-001: no file becomes downloadable before a malware scan.
#   enforce    — refuse download unless the scan returned clean. Required in
#                production. With no scanner configured, files stay quarantined.
#   bypass_dev — mark uploads clean without scanning. Development only; the API
#                refuses to boot with this set when NODE_ENV=production.
FILE_SCAN_MODE=enforce
# Optional scanner endpoint. Receives {publicId, resourceType, bytes} and
# returns {"verdict":"clean"|"infected"}. Any other answer leaves the file
# quarantined — an outage must never turn into an unscanned file being served.
FILE_SCAN_PROVIDER_URL=

# --- Outbound providers ------------------------------------------------------
# SI-007 SMS aggregator, SI-008 WhatsApp Business, SI-009 email.
# Unset in development: the notification service logs to the console instead of
# sending, and records the notification row either way.
# SI-007 / AS-04: an SMS aggregator with delivery to MTN, Orange and
# Camtel/Nexttel. Both URL and token are required; one without the other counts
# as unconfigured and the message is logged instead of sent.
#
# The transport POSTs {"to","from","text"} as JSON with `Authorization: Bearer
# <token>`, which most aggregators accept. Adjust sms.transport.ts if yours
# differs.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
# Registered sender ID. Many Cameroonian routes reject unregistered alphanumeric
# senders, so confirm this with the aggregator before launch.
SMS_SENDER_ID=ClassConnect
# NFR-DEP-001: explicit timeout and bounded retries.
SMS_TIMEOUT_MS=10000
SMS_MAX_ATTEMPTS=3
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@classconnect.example

# Development convenience only. When true, the OTP is returned in the API
# response so the flow can be exercised without an SMS provider.
# Refused at boot on deployed infrastructure.
DEV_EXPOSE_OTP=true

# Development convenience only. Lets Admin and Support accounts sign in with a
# password alone, without the second factor FR-AUT-009 requires.
#
# The requirement is enforced by role rather than by enrolment, so an admin
# account with no authenticator enrolled cannot sign in at all — and cannot
# enrol one without signing in first. This is the way out of that on a laptop.
#
# Refused at boot on deployed infrastructure. An administrator can approve
# teachers and read minors' data; behind a password alone, one leaked password
# is the whole platform. Enrol properly before going live:
#     node packages/db/scripts/admin-mfa.mjs on you@example.com
DEV_DISABLE_STAFF_MFA=false
