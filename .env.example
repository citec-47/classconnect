# ClassConnect — environment template.
#
# NFR-SEC-007: secrets live in a managed secret store, never in source control.
# This file documents the required variables; it must contain no real secret.
# Copy to .env for local development only.

NODE_ENV=development

# --- Database (§2.4: PostgreSQL 15+) -----------------------------------------
# Managed PostgreSQL (Neon). Raise connect_timeout above Prisma's 5s default:
# serverless Postgres scales compute to zero when idle and a cold start
# regularly exceeds it, which otherwise stops the API booting.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connect_timeout=30&pool_timeout=30

# Local alternative, via docker compose or packages/db/scripts/local-postgres.mjs:
# DATABASE_URL=postgresql://classconnect:classconnect_dev@localhost:5433/classconnect?schema=public

# --- Redis (NFR-AVL-004: session state and rate-limit counters) --------------
REDIS_URL=redis://localhost:6380

# --- API ---------------------------------------------------------------------
API_PORT=4000
# COM-002: the public API is versioned by URL path prefix.
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000

# --- Tokens (FR-AUT-006) -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-value
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-value

# --- Application-layer encryption (NFR-SEC-003) ------------------------------
# Identity documents, payout details and safeguarding reports are encrypted with
# a key separate from the database credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key

# --- Object storage / CDN (SI-006) -------------------------------------------
# The API key must hold the `create` and `read` actions on the product
# environment, or every upload is refused with "missing permissions".
# The upload preset must exist and be in Signed mode — the server signs each
# upload against a narrow parameter allow-list.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=classconnect
# FR-FIL-003: how long a signed read URL stays valid.
FILE_SIGNED_URL_TTL_SECONDS=300

# FR-FIL-001: no file becomes downloadable before a malware scan.
#   enforce    — refuse download unless the scan returned clean. Required in
#                production. With no scanner configured, files stay quarantined.
#   bypass_dev — mark uploads clean without scanning. Development only; the API
#                refuses to boot with this set when NODE_ENV=production.
FILE_SCAN_MODE=enforce
# Optional scanner endpoint. Receives {publicId, resourceType, bytes} and
# returns {"verdict":"clean"|"infected"}. Any other answer leaves the file
# quarantined — an outage must never turn into an unscanned file being served.
FILE_SCAN_PROVIDER_URL=

# --- Outbound providers ------------------------------------------------------
# SI-007 SMS aggregator, SI-008 WhatsApp Business, SI-009 email.
# Unset in development: the notification service logs to the console instead of
# sending, and records the notification row either way.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@classconnect.example

# Development convenience only. When true, the OTP is returned in the API
# response so the flow can be exercised without an SMS provider.
# Refused at boot when NODE_ENV=production.
DEV_EXPOSE_OTP=true
