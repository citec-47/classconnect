{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --workspaces --include-workspace-root",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,../../node_modules/.prisma/**,../../node_modules/@prisma/client/**}",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/jobs/billing-pass",
      "schedule": "0 5 * * *"
    }
  ],
  "env": {
    "CC_DISABLE_SCHEDULERS": "true"
  }
}