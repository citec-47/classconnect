{
  "name": "@classconnect/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "//predev": "Local development only — Vercel runs `build`, never this. It generates the Prisma client because the API's prebuild no longer does, and nothing else in the `npm run dev --workspace @classconnect/web` chain would: without it a schema change stays invisible until the next npm install.",
    "predev": "npm run generate --workspace @classconnect/db && npm run build --workspace @classconnect/api",
    "dev": "next dev --turbopack -p 3000",
    "prebuild": "npm run build --workspace @classconnect/api",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "jest"
  },
  "dependencies": {
    "@classconnect/shared": "1.0.0",
    "hls.js": "^1.7.0",
    "livekit-client": "^2.21.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.12"
  }
}
