{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Next compiles the JSX itself in the app build and wants it left alone;
    // ts-jest has to emit it.
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "jest.setup.ts"]
}
