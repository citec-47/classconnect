{
  "name": "classconnect",
  "version": "1.0.0",
  "private": true,
  "description": "ClassConnect — Online Learning Platform for Cameroon (SRS-CC-CM-001 v1.0)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @classconnect/api",
    "dev:web": "npm run dev --workspace @classconnect/web",
    "build": "npm run build --workspace @classconnect/shared && npm run build --workspace @classconnect/db && npm run build --workspace @classconnect/api && npm run build --workspace @classconnect/web",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "npm run generate --workspace @classconnect/db",
    "db:migrate": "npm run migrate --workspace @classconnect/db",
    "db:seed": "npm run seed --workspace @classconnect/db",
    "db:reset": "npm run reset --workspace @classconnect/db",
    "setup": "npm run db:up && npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "npm run test --workspace @classconnect/api",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
