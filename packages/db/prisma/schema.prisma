// ClassConnect — database schema
// Realises SRS §5 (Data requirements). Entity list per §5.1, rules per §5.2.
//
// Standing rules applied throughout:
//   DAT-001  Referential integrity is enforced by foreign keys, not application code alone.
//   DAT-002  Money is BigInt whole XAF. Float/Decimal are never used for money (CON-02).
//   DAT-003  Timestamps are timestamptz stored in UTC.
//   DAT-004  Uniqueness on users.phone_e164, users.email, payments.idempotency_key,
//            (teacher_id, starts_at_utc), (learner_id, period).
//   DAT-005  ledger_entries and audit_log are append-only, enforced by DB grants
//            (see migration 002_append_only.sql).
//   DAT-006  Deletion is soft (status + deleted_at) except for lawful erasure (§7.3).
//   DAT-007  Every table holding personal data appears in the data inventory
//            (docs/data-inventory.md) with retention period and lawful basis.

generator client {
  provider = "prisma-client-js"
  // No custom `output`: npm workspaces hoist @prisma/client to the repo root,
  // and that package resolves `.prisma/client` relative to itself. Redirecting
  // the generator elsewhere leaves the runtime importing an empty client.

  /// The query engine is a native binary, and one is built per platform.
  ///
  /// `native` covers the developer machine that ran `prisma generate`. Vercel's
  /// Node runtime is AWS Lambda on Amazon Linux 2023, which needs
  /// `rhel-openssl-3.0.x`; without it the deployed function starts and then
  /// fails on its first query with "Query engine library for current platform
  /// not found" — at runtime, not at build time, so the deploy looks green.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

  /// The connection the application uses.
  ///
  /// On serverless this must point at a *pooler* (PgBouncer in transaction mode
  /// — Neon's `-pooler` host, Supabase's port 6543, Vercel Postgres's pooled
  /// URL). Every function instance opens its own connections, and a platform
  /// that scales to dozens of instances will exhaust a small Postgres's
  /// connection limit within minutes without one.
  url = env("DATABASE_URL")

  /// The connection migrations use.
  ///
  /// `prisma migrate` needs to create advisory locks and run DDL, neither of
  /// which survives a transaction-mode pooler — it fails with "prepared
  /// statement already exists" or hangs on the lock. This is the direct,
  /// unpooled connection to the same database.
  ///
  /// Prisma requires this to be set whenever it is declared — there is no
  /// implicit fallback to `url`. Locally, where `npm run db:local` has no pooler
  /// in front of it, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// FR-RBA-001: the eight platform roles.
enum Role {
  parent
  student
  adult_learner
  teacher
  support_agent
  admin_ops
  admin_finance
  super_admin
}

enum UserStatus {
  pending_verification
  active
  suspended
  archived
  deleted
}

/// NFR-LOC-001: English and French are equal first-class languages.
enum Language {
  en
  fr
}

/// The teaching bands an Admin classifies people into.
///
/// FR-PRO-001 lists six education levels; this groups them the way staff
/// actually think about them, and the way teachers are actually hired.
///
/// Lower and Upper Sixth are their own band rather than the tail of secondary:
/// the subjects diverge, the teaching is closer to examination coaching, and a
/// Form 2 teacher is not automatically an Upper Sixth teacher. Splitting them
/// lets an Admin classify a teacher for exactly the band they are qualified for.
///
/// The GCE examination tracks stay under `secondary` — a learner preparing for
/// GCE O/L is a secondary-school learner sitting an exam, not a sixth-former.
enum SchoolType {
  primary
  secondary
  sixth_form
}

/// FR-TVR-003: teacher application lifecycle.
/// Only `approved` teachers may be listed, assigned, or paid.
enum VerificationStatus {
  draft
  submitted
  under_review
  approved
  rejected
  more_info_required
}

enum TeacherDocumentType {
  national_id
  passport
  degree_certificate
  diploma
  teaching_authorisation
  /// A short spoken introduction, recorded by the applicant.
  ///
  /// A certificate says what somebody studied; it says nothing about whether
  /// they can hold a Form 3 class's attention. It is also the cheapest check
  /// against a stolen identity — the face and voice on the video either match
  /// the ID document or they do not (FR-TVR-005).
  intro_video
  other
}

/// FR-AUT-002/004: one-time codes for phone verification.
enum OtpPurpose {
  registration
  login
  password_reset
  phone_change
}

enum OtpChannel {
  sms
  whatsapp
  voice
  email
}

/// Appendix A — session state model.
enum SessionStatus {
  scheduled
  in_progress
  completed
  cancelled_by_learner
  cancelled_by_teacher
  no_show_teacher
  no_show_learner
  aborted
  disputed
  voided
}

enum SessionType {
  one_to_one
  group
}

/// Appendix B — payment state model.
enum PaymentStatus {
  initiated
  pending
  succeeded
  failed
  pending_reconciliation
  refunded
  partially_refunded
}

enum PaymentMethod {
  mtn_momo
  orange_money
  visa
  mastercard
}

/// FR-PAY-007: subscription lifecycle.
enum SubscriptionStatus {
  pending_payment
  active
  grace
  expired
  cancelled
  suspended
}

enum BillingPeriod {
  monthly
  annual
}

enum AssignmentStatus {
  proposed
  accepted
  declined
  lapsed
  ended
}

enum LedgerDirection {
  debit
  credit
}

enum PayoutStatus {
  requested
  approved
  processing
  paid
  failed
  rejected
}

enum NotificationChannel {
  in_app
  email
  sms
  whatsapp
}

enum NotificationStatus {
  queued
  sent
  delivered
  failed
  suppressed
}

enum TicketStatus {
  open
  in_progress
  waiting_on_user
  resolved
  closed
}

enum TicketCategory {
  general
  billing
  technical
  safeguarding
  payment_dispute
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum ModerationStatus {
  pending
  approved
  rejected
}

/// FR-SAF-009 / NFR-PRV-003: recorded, timestamped consents.
enum ConsentType {
  terms_of_service
  privacy_notice
  guardian_consent_minor
  session_recording
  marketing
  code_of_conduct
  safeguarding_policy
  commercial_terms
}

enum AssessmentType {
  quiz
  mock_exam
}

enum QuestionType {
  single_choice
  multiple_response
  true_false
  numeric
  short_text
  matching
  free_response
}

enum ExamBoardLevel {
  gce_ordinary
  gce_advanced
}

enum RightsStatus {
  unverified
  licensed
  permission_granted
  originally_authored
}

/// §4.2: a learner account is queued for an Admin decision before it becomes
/// active. Deliberately separate from `UserStatus`, because "approved" is a
/// verification outcome while "active" is an account lifecycle state.
enum LearnerApprovalState {
  submitted
  more_info_required
  approved
  rejected
}

/// §5.1 of the admin brief: the payer chooses one of these at enrolment.
/// Paying in full is always offered and is the visually primary option.
enum InstalmentPlanType {
  full
  three_instalments
}

/// §5.2: scheduled -> due -> paid, or scheduled -> due -> overdue -> paid.
/// `cancelled` covers a settle-in-full, which clears all future instalments.
enum InstalmentState {
  scheduled
  due
  overdue
  paid
  cancelled
}

/// §5.5: a freeze applies either to a learner's service or to a teacher's account.
enum FreezeScope {
  learner
  teacher
}

/// §5.5: a manual freeze outranks the automatic rule — paying an instalment
/// lifts an `automatic` freeze but never a `manual` one.
enum FreezeKind {
  automatic
  manual
}

enum FreezeCategory {
  non_payment
  safeguarding
  abuse
  dispute
  other
}

/// §4.6: where a safeguarding concern came from.
enum SafeguardingSource {
  session
  message_thread
  teacher_profile
  redaction_flag
  other
}

/// FR-SAF-005: `open` starts a 4-hour first-response clock.
enum SafeguardingState {
  open
  in_review
  actioned
  closed
}

/// FR-SAF-002: what a teacher repeatedly tried to share with a minor.
enum RedactionKind {
  phone
  email
  social_handle
}

/// FR-LDG-003: an item on a provider settlement report, matched or not.
enum ReconciliationState {
  unmatched
  matched
  written_off
  escalated
}

/// FR-SUP-001: where a support request arrived from.
enum TicketChannel {
  in_app
  whatsapp
  email
}

enum AgentPresence {
  online
  away
  offline
}

/// FR-ERN-004: a learner who attended nothing still funded a pool share. It goes
/// here for an Admin decision and is never silently swept into platform revenue.
enum UnallocatedDecision {
  pending
  released_to_teachers
  retained_by_platform
  carried_forward
}

// ---------------------------------------------------------------------------
// §5.1 — Identity and access
// ---------------------------------------------------------------------------

/// `users` — every authenticable identity.
model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// DAT-004 + FR-AUT-002: E.164 (+237XXXXXXXXX) is the primary identifier.
  phoneE164         String?    @unique @map("phone_e164") @db.VarChar(20)
  email             String?    @unique @db.VarChar(320)
  /// NFR-SEC-001: Argon2id hash. Never a plaintext password anywhere.
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  googleSub         String?    @unique @map("google_sub") @db.VarChar(255)
  fullName          String     @map("full_name") @db.VarChar(200)
  preferredLanguage Language   @default(en) @map("preferred_language")
  status            UserStatus @default(pending_verification)

  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  /// FR-AUT-009: MFA is mandatory for admin and support roles.
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaSecret  String? @map("mfa_secret") @db.VarChar(255)

  /// FR-AUT-007: lock for 15 minutes after 10 consecutive failures.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// DAT-006: soft deletion.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles            UserRole[]
  learnerProfile   Learner?           @relation("LearnerUser")
  guardianProfile  Guardian?
  teacherProfile   Teacher?
  authSessions     AuthSession[]
  otpCodes         OtpCode[]
  consents         Consent[]
  notifications    Notification[]
  auditEntries     AuditLog[]         @relation("AuditActor")
  paidSubscriptions Subscription[]    @relation("SubscriptionPayer")
  ticketsRequested Ticket[]           @relation("TicketRequester")
  ticketsAssigned  Ticket[]           @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  reviewsWritten   Review[]           @relation("ReviewRater")
  sessionSeats     SessionParticipant[]
  guardianLinks    GuardianLearner[]  @relation("GuardianLink")
  timetableConfirmed TimetableSlot[]  @relation("TimetableSlotConfirmer")
  materialsUploaded Material[]
  publishRequests  MediaPublishRequest[]
  recordingPlayback RecordingPlayback[]
  threadSeats      ThreadParticipant[]
  messagesSent     Message[]
  exercisesUnlocked WorkAssignment[]  @relation("ExerciseUnlocker")
  groupScoresAwarded GroupScore[]     @relation("GroupScoreAwarder")
  reportCardsGenerated ReportCard[]   @relation("ReportCardGenerator")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// `user_roles` — role assignment (FR-RBA-001).
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// FR-AUT-006/010: refresh-token family with per-device visibility and revocation.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// The refresh token itself is never stored — only its hash.
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceLabel      String?   @map("device_label") @db.VarChar(200)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  approxLocation   String?   @map("approx_location") @db.VarChar(200)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// FR-AUT-002/004: 6-digit OTP, 5-minute expiry, at most 5 attempts, invalidated on use.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  /// Destination is stored so issuance can be rate-limited per number (FR-AUT-004).
  destination String     @db.VarChar(320)
  /// NFR-SEC-009: the code is hashed; OTPs never appear in logs or storage in clear.
  codeHash    String     @map("code_hash") @db.VarChar(255)
  purpose     OtpPurpose
  channel     OtpChannel @default(sms)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// §5.1 — Party detail per role
// ---------------------------------------------------------------------------

/// `guardians` — an adult financially and legally responsible for learners.
model Guardian {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  learners GuardianLearner[]

  @@map("guardians")
}

/// `learners` — a minor Student under a Guardian, or an Adult Learner.
model Learner {
  id     String  @id @default(uuid()) @db.Uuid
  /// Null while a Parent-managed minor has not been granted their own sign-in
  /// (FR-FAM-003 allows credentials to be granted and revoked at any time).
  userId String? @unique @map("user_id") @db.Uuid

  fullName String   @map("full_name") @db.VarChar(200)
  /// FR-FAM-006: minor status is derived from date of birth, never stored as a flag.
  dob      DateTime @map("dob") @db.Date
  levelId  String?  @map("level_id") @db.Uuid

  /// FR-PRO-003: instruction preferences.
  preferredLanguage    Language  @default(en) @map("preferred_language")
  preferredStudyDays   Int[]     @map("preferred_study_days")
  preferredStartTime   String?   @map("preferred_start_time") @db.VarChar(5)
  preferredEndTime     String?   @map("preferred_end_time") @db.VarChar(5)
  targetExamSession    String?   @map("target_exam_session") @db.VarChar(50)
  targetExamDate       DateTime? @map("target_exam_date") @db.Date

  status    UserStatus @default(active)

  /// §4.2: the approval queue. A learner may not transact or attend until an
  /// Admin has approved them, and the deciding Admin is recorded (FR-AI-005).
  approvalState  LearnerApprovalState @default(submitted) @map("approval_state")
  submittedAt    DateTime?  @map("submitted_at") @db.Timestamptz(6)
  approvedBy     String?    @map("approved_by") @db.Uuid
  approvedAt     DateTime?  @map("approved_at") @db.Timestamptz(6)
  /// Mandatory on reject and on request-more-information, and sent to the guardian.
  decisionReason String?    @map("decision_reason") @db.Text

  /// FR-RBA-004: which Admin created this learner account.
  createdBy String?    @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// FR-FAM-005: archived rather than deleted while obligations exist.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  user      User?             @relation("LearnerUser", fields: [userId], references: [id])
  level     Level?            @relation(fields: [levelId], references: [id])
  guardians GuardianLearner[]
  subjects  LearnerSubject[]

  assignments   Assignment[]
  sessions      Session[]
  subscriptions Subscription[]
  submissions   Submission[]
  attempts      Attempt[]
  cohortSeats   CohortMember[]
  freezes       AccountFreeze[]
  redactionFlags RedactionFlag[]
  messageThreads MessageThread[]
  reportCards    ReportCard[]
  termMarks      SubjectTermMark[]

  @@index([levelId])
  /// §4.2/§4.3: the approval queues select on state and order by submission.
  @@index([approvalState, submittedAt])
  @@map("learners")
}

/// FR-FAM-001/004: a learner may have more than one linked Guardian,
/// each with full or view-only rights.
model GuardianLearner {
  id          String    @id @default(uuid()) @db.Uuid
  guardianId  String    @map("guardian_id") @db.Uuid
  learnerId   String    @map("learner_id") @db.Uuid
  /// FR-FAM-004: `full` may transact; `view_only` may read.
  accessLevel String    @default("full") @map("access_level") @db.VarChar(20)
  isPrimary   Boolean   @default(false) @map("is_primary")
  invitedBy   String?   @map("invited_by") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  guardian    Guardian @relation(fields: [guardianId], references: [userId], onDelete: Cascade)
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  invitedByUser User?  @relation("GuardianLink", fields: [invitedBy], references: [id])

  @@unique([guardianId, learnerId])
  @@index([learnerId])
  @@map("guardian_learners")
}

/// `teachers` — teacher detail and verification state.
model Teacher {
  userId String @id @map("user_id") @db.Uuid

  /// Chosen by the Admin at account creation: does this teacher teach in
  /// primary or secondary school. Every subject they are given must sit at a
  /// level of this type, which the service enforces.
  schoolType SchoolType? @map("school_type")
  /// FR-RBA-004 / FR-TVR-010: which Admin brought this account into existence.
  createdBy  String?     @map("created_by") @db.Uuid

  bio             String? @db.Text
  yearsExperience Int     @default(0) @map("years_experience")
  photoKey        String? @map("photo_key") @db.VarChar(500)
  languages       Language[]

  /// FR-PRO-005: identity and payout detail are never visible to learners or parents.
  /// NFR-SEC-003: encrypted at the application layer with a separate key.
  nationalIdEnc   String? @map("national_id_enc") @db.Text
  addressEnc      String? @map("address_enc") @db.Text
  payoutWalletEnc String? @map("payout_wallet_enc") @db.Text
  payoutMethod    PaymentMethod? @map("payout_method")
  /// FR-ERN-010: no payout to an unverified wallet or an incomplete KYC record.
  walletVerified  Boolean @default(false) @map("wallet_verified")
  kycComplete     Boolean @default(false) @map("kyc_complete")

  highestQualification String? @map("highest_qualification") @db.VarChar(200)
  institution          String? @map("institution") @db.VarChar(200)
  qualificationYear    Int?    @map("qualification_year")

  verificationStatus VerificationStatus @default(draft) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  rejectionReason    String?            @map("rejection_reason") @db.Text
  submittedAt        DateTime?          @map("submitted_at") @db.Timestamptz(6)

  /// FR-TVR-009: suspension cancels future sessions and freezes payouts.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason") @db.Text

  /// FR-RAT-002: public rating is withheld below a configurable minimum count.
  ratingAvg        Decimal? @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int      @default(0) @map("rating_count")
  lessonsDelivered Int      @default(0) @map("lessons_delivered")
  reliabilityScore Decimal? @map("reliability_score") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents TeacherDocument[]
  subjects  TeacherSubject[]
  checklist VerificationChecklistItem[]

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  assignments            Assignment[]
  sessions               Session[]
  cohorts                Cohort[]
  earnings               Earning[]
  payouts                Payout[]
  reviews                Review[]
  workAssignments        WorkAssignment[]
  freezes                AccountFreeze[]
  redactionFlags         RedactionFlag[]
  safeguardingReports    SafeguardingReport[]
  timetableSlots         TimetableSlot[]
  reportCardLines        ReportCardLine[]
  termMarks              SubjectTermMark[]

  @@index([verificationStatus])
  /// The roster filters by band; unclassified teachers cannot be assigned a
  /// learner (FR-SCH-002) and are the most-read subset of this column.
  @@index([schoolType])
  @@map("teachers")
}

/// The state a proposed teaching hour is in.
///
/// Confirmation is what makes a slot count: earnings are counted inside a
/// confirmed slot, and a live session starts from one. A `proposed` slot is a
/// teacher saying when they can teach; it timetables nobody until staff agree.
/// The three grids a period can sit in.
///
/// `private` is not a time of day — it is a different arrangement altogether:
/// 24/7, filled by an admin rather than claimed by a teacher, for learners who
/// are taught at hours that suit them.
enum TimetableSession {
  day
  evening
  private
}

enum TimetableSlotState {
  /// Retained for the slots already recorded under the propose-then-confirm
  /// flow, and for the private timetable, where the admin fills the grid and a
  /// teacher's own claim is not what creates the slot.
  proposed
  confirmed
  rejected
  /// An admin has suspended this period. Students and teachers in the class see
  /// it as a Free Period: the room still opens, nobody is timetabled to teach,
  /// and nothing accrues against it.
  on_hold
}

/// `timetable_slots` — the timetabled teaching week.
///
/// Distinct from `AvailabilityRule`, and the difference matters: availability is
/// when a teacher is *free*, this is what they are *timetabled to teach*. The
/// two were conflated in an earlier draft and the result was a timetable that
/// showed every teacher as teaching every hour they had not blocked out.
///
/// A slot belongs to a level (Class One … Upper Sixth) and optionally to one
/// cohort within it — a private arrangement is a slot with no cohort. Students
/// read their timetable from the slots for their level, so "only the people in
/// that class see it" is a `where`, not a filter applied in the UI.
model TimetableSlot {
  id        String @id @default(uuid()) @db.Uuid
  levelId   String @map("level_id") @db.Uuid
  cohortId  String? @map("cohort_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  /// 1 = Monday … 7 = Sunday.
  ///
  /// Was 1–5. Widened because the school week is configurable — 24/5 by
  /// default, 24/6 or 24/7 when the platform is set that way — and because the
  /// private session runs 24/7 regardless of what the school week is set to.
  /// `SCHOOL_WEEK_DAYS` in `PlatformConfig` decides which of these a class
  /// timetable may use; the column simply has to be able to hold Sunday.
  dayOfWeek Int @map("day_of_week") @db.SmallInt

  /// Which of the three sessions this period belongs to.
  ///
  /// Derivable from `startMinute`, and stored anyway: the private session
  /// overlaps both of the others in wall-clock terms (it is 24/7), so the time
  /// alone cannot say which grid a slot belongs to.
  session TimetableSession @default(day)

  /// Minutes from midnight, not a `time`.
  ///
  /// The clash rule is interval arithmetic, and integers compare and subtract
  /// without a timezone anywhere near them. A `time` column invites the
  /// database's session timezone into a question that has nothing to do with
  /// one — the school day is local wall-clock by definition.
  startMinute Int @map("start_minute") @db.SmallInt
  endMinute   Int @map("end_minute") @db.SmallInt

  state       TimetableSlotState @default(proposed)
  /// FR-TVR-004-style attribution: who agreed this, and when.
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Why a proposal was refused, shown to the teacher who made it.
  decisionNote String?  @map("decision_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  cohort    Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  teacher   Teacher  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  confirmer User?    @relation("TimetableSlotConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  /// Lessons actually taught in this slot. FR-ERN-003 counts against these.
  sessions  Session[]

  /// The two reads this table exists for: a teacher's week, and a class's week.
  @@index([teacherId, dayOfWeek])
  @@index([levelId, dayOfWeek])
  @@map("timetable_slots")
}

/// `teacher_documents` — credential evidence (FR-TVR-002/007).
model TeacherDocument {
  id         String              @id @default(uuid()) @db.Uuid
  teacherId  String              @map("teacher_id") @db.Uuid
  type       TeacherDocumentType
  fileName   String              @map("file_name") @db.VarChar(300)
  storageKey String              @map("storage_key") @db.VarChar(500)
  mimeType   String              @map("mime_type") @db.VarChar(100)
  sizeBytes  Int                 @map("size_bytes")
  /// FR-FIL-001: nothing is downloadable until it has passed a malware scan.
  scanStatus String              @default("pending") @map("scan_status") @db.VarChar(20)
  /// FR-TVR-007: expiry drives re-verification prompts 30 days out.
  expiresOn  DateTime?           @map("expires_on") @db.Date
  verified   Boolean             @default(false)
  uploadedAt DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId])
  @@index([expiresOn])
  @@map("teacher_documents")
}

/// FR-TVR-004/005: approval requires each checklist item to be affirmatively recorded.
/// Bulk approval is impossible by construction — every item carries its own verifier.
model VerificationChecklistItem {
  id         String    @id @default(uuid()) @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid
  itemKey    String    @map("item_key") @db.VarChar(100)
  verified   Boolean   @default(false)
  findings   String?   @db.Text
  verifiedBy String?   @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@unique([teacherId, itemKey])
  @@map("verification_checklist_items")
}

// ---------------------------------------------------------------------------
// §5.1 — Catalogue
// ---------------------------------------------------------------------------

/// `levels` — education-level taxonomy (FR-PRO-001).
model Level {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(50)
  nameEn String @map("name_en") @db.VarChar(100)
  nameFr String @map("name_fr") @db.VarChar(100)
  /// The Admin's first choice when creating a student or teacher account.
  schoolType SchoolType @map("school_type")
  /// The finer grouping kept from FR-PRO-001: primary, secondary, high_school,
  /// exam, adult. `schoolType` is what the UI offers; this stays for reporting
  /// and for the GCE preparation areas in §4.8.
  category  String   @db.VarChar(50)
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subjects      LevelSubject[]
  learners      Learner[]
  teacherSubjects TeacherSubject[]

  @@index([schoolType, sortOrder])
  cohorts       Cohort[]
  materials     Material[]
  pastPapers    PastPaper[]
  timetableSlots TimetableSlot[]
  assessments   Assessment[]
  reportCards   ReportCard[]
  termMarks     SubjectTermMark[]

  @@map("levels")
}

/// `subjects` — subject catalogue (FR-PRO-002).
model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  /// Science subjects attract a distinct plan (FR-PAY-002).
  isScience Boolean  @default(false) @map("is_science")
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  levels          LevelSubject[]
  teacherSubjects TeacherSubject[]
  learnerSubjects LearnerSubject[]
  assignments     Assignment[]
  sessions        Session[]
  cohorts         Cohort[]
  timetableSlots  TimetableSlot[]
  materials       Material[]
  workAssignments WorkAssignment[]
  assessments     Assessment[]
  pastPapers      PastPaper[]
  reportCardLines ReportCardLine[]
  termMarks       SubjectTermMark[]

  @@map("subjects")
}

/// `level_subjects` — which subjects are offered at which level.
model LevelSubject {
  levelId   String @map("level_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([levelId, subjectId])
  @@map("level_subjects")
}

/// `teacher_subjects` — what a teacher offers, per level.
model TeacherSubject {
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  levelId   String @map("level_id") @db.Uuid

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId, levelId])
  @@map("teacher_subjects")
}

/// FR-PRO-003: the learner's selected subjects.
model LearnerSubject {
  learnerId  String   @map("learner_id") @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  /// FR-GCE-003: self-declared confidence feeds the revision timetable.
  confidence Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([learnerId, subjectId])
  @@map("learner_subjects")
}

// ---------------------------------------------------------------------------
// §5.1 — Scheduling
// ---------------------------------------------------------------------------

/// `availability_rules` — recurring weekly availability in Africa/Douala local time
/// (FR-SCH-001). Local time is intentional here: the teacher reasons in local time.
model AvailabilityRule {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  /// 0 = Sunday .. 6 = Saturday.
  weekday   Int
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId, weekday])
  @@map("availability_rules")
}

/// `availability_exceptions` — one-off unavailable dates or extra slots (FR-SCH-001).
model AvailabilityException {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  date      DateTime @db.Date
  /// `unavailable` | `extra_slot`
  type      String   @db.VarChar(20)
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)
  reason    String?  @db.VarChar(300)

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId, date])
  @@map("availability_exceptions")
}

/// `assignments` — the teacher↔learner relationship (FR-SCH-002).
model Assignment {
  id         String           @id @default(uuid()) @db.Uuid
  teacherId  String           @map("teacher_id") @db.Uuid
  learnerId  String           @map("learner_id") @db.Uuid
  subjectId  String           @map("subject_id") @db.Uuid
  status     AssignmentStatus @default(proposed)
  assignedBy String?          @map("assigned_by") @db.Uuid
  /// FR-SCH-002: the teacher must accept within a configurable window (default 24h),
  /// after which the assignment lapses and re-enters the queue.
  respondBy  DateTime?        @map("respond_by") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  declinedAt DateTime?        @map("declined_at") @db.Timestamptz(6)
  endedAt    DateTime?        @map("ended_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([teacherId, status])
  @@index([learnerId, status])
  @@map("assignments")
}

/// `cohorts` — named groups sharing a recurring group-class schedule.
model Cohort {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(200)
  teacherId      String   @map("teacher_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  levelId        String   @map("level_id") @db.Uuid
  /// FR-SCH-006: booking fails when capacity is reached.
  capacity       Int
  recurrenceRule String?  @map("recurrence_rule") @db.VarChar(300)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher        @relation(fields: [teacherId], references: [userId])
  subject Subject        @relation(fields: [subjectId], references: [id])
  level   Level          @relation(fields: [levelId], references: [id])
  members CohortMember[]
  sessions Session[]
  timetableSlots TimetableSlot[]
  assessments    Assessment[]
  groupScores    GroupScore[]

  @@map("cohorts")
}

model CohortMember {
  cohortId  String   @map("cohort_id") @db.Uuid
  learnerId String   @map("learner_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@id([cohortId, learnerId])
  @@map("cohort_members")
}

/// `sessions` — a scheduled teaching event. State model per Appendix A.
model Session {
  id           String        @id @default(uuid()) @db.Uuid
  teacherId    String        @map("teacher_id") @db.Uuid
  /// Exactly one of learnerId (one-to-one) or cohortId (group) is set.
  learnerId    String?       @map("learner_id") @db.Uuid
  cohortId     String?       @map("cohort_id") @db.Uuid
  subjectId    String        @map("subject_id") @db.Uuid
  /// DAT-003/DAT-004: stored UTC, unique per (teacher, start) to bar double-booking.
  startsAtUtc  DateTime      @map("starts_at_utc") @db.Timestamptz(6)
  durationMin  Int           @map("duration_min")
  type         SessionType
  status       SessionStatus @default(scheduled)
  /// SI-005: the media server room this session maps to.
  roomId       String?       @map("room_id") @db.VarChar(200)
  /// The confirmed timetable slot this session was claimed against, recorded when
  /// it went live.
  ///
  /// FR-ERN-003 pays for timetabled teaching and the brief lets a teacher go live
  /// at any time, so the two facts differ and both matter. Deriving the slot
  /// afterwards by matching a start time against the week is guesswork the moment
  /// a slot is edited; this records what was true at the instant of going live.
  timetableSlotId String?    @map("timetable_slot_id") @db.Uuid
  /// FR-SAF-004: minor one-to-one sessions default to recording enabled.
  recordingEnabled Boolean   @default(false) @map("recording_enabled")
  endedAt      DateTime?     @map("ended_at") @db.Timestamptz(6)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?       @map("cancel_reason") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher      Teacher              @relation(fields: [teacherId], references: [userId])
  learner      Learner?             @relation(fields: [learnerId], references: [id])
  cohort       Cohort?              @relation(fields: [cohortId], references: [id])
  subject      Subject              @relation(fields: [subjectId], references: [id])
  timetableSlot TimetableSlot?      @relation(fields: [timetableSlotId], references: [id])
  participants SessionParticipant[]
  recordings   Recording[]
  reviews      Review[]
  publishRequests MediaPublishRequest[]

  /// DAT-004: a teacher cannot hold two sessions at the same instant.
  @@unique([teacherId, startsAtUtc])
  @@index([startsAtUtc])
  @@index([status])
  /// The teacher's own live board: "am I live right now".
  @@index([teacherId, status])
  /// The live board and the weekly timetable both read a status and a window.
  @@index([status, startsAtUtc])
  @@index([startsAtUtc, teacherId])
  @@map("sessions")
}

/// `session_participants` — attendance, sourced from the media server's
/// authoritative join/leave events (FR-LIV-014, SI-005).
model SessionParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  firstJoinAt     DateTime? @map("first_join_at") @db.Timestamptz(6)
  lastLeaveAt     DateTime? @map("last_leave_at") @db.Timestamptz(6)
  /// The unit of revenue attribution (FR-ERN-003).
  attendedMinutes Int       @default(0) @map("attended_minutes")
  /// §1.3 — reported to the learner, their guardian, the teacher and admin.
  /// Never scored, never ranked, never shown to other learners.
  micOnMinutes    Int       @default(0) @map("mic_on_minutes")
  cameraOnMinutes Int       @default(0) @map("camera_on_minutes")
  /// Null while the stream was on for some of the session. Set when it was off
  /// throughout, and then it must say *why* — see `StreamOffReason`. Recording
  /// "camera off" without the reason attributes FR-LIV-009's own bandwidth
  /// decision to the learner, which §1.3 calls a defect.
  micOffReason    StreamOffReason? @map("mic_off_reason")
  cameraOffReason StreamOffReason? @map("camera_off_reason")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  /// Teacher hours aggregate attendance by user across every session.
  @@index([userId])
  @@map("session_participants")
}

/// `recordings` — retained 90 days by default (§5.5, subject to OI-09).
model Recording {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  storageKey     String    @map("storage_key") @db.VarChar(500)
  durationSec    Int       @map("duration_sec")
  sizeBytes      BigInt?   @map("size_bytes")
  availableUntil DateTime  @map("available_until") @db.Timestamptz(6)
  /// A safeguarding or dispute flag suspends the retention clock (§5.5).
  legalHold      Boolean   @default(false) @map("legal_hold")
  /// §3: an audio-only rendition. On a metered 3G connection this is the
  /// difference between using the feature and not (NFR-BAN-002), so it is a
  /// stored artefact rather than a player setting over the full-size video.
  audioKey       String?   @map("audio_key") @db.VarChar(500)
  audioSizeBytes BigInt?   @map("audio_size_bytes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session  Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playback RecordingPlayback[]

  @@index([availableUntil])
  @@map("recordings")
}

// ---------------------------------------------------------------------------
// §5.1 — Coursework and assessment
// ---------------------------------------------------------------------------

/// `materials` — study resources (FR-MAT-001).
model Material {
  id              String   @id @default(uuid()) @db.Uuid
  uploadedBy      String   @map("uploaded_by") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  levelId         String   @map("level_id") @db.Uuid
  topic           String?  @db.VarChar(200)
  title           String   @db.VarChar(300)
  storageKey      String   @map("storage_key") @db.VarChar(500)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  /// FR-FIL-005: every file carries an owner and a visibility scope.
  visibilityScope String   @map("visibility_scope") @db.VarChar(20)
  targetLearnerId String?  @map("target_learner_id") @db.Uuid
  targetCohortId  String?  @map("target_cohort_id") @db.Uuid
  scanStatus      String   @default("pending") @map("scan_status") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User    @relation(fields: [uploadedBy], references: [id])
  subject  Subject @relation(fields: [subjectId], references: [id])
  level    Level   @relation(fields: [levelId], references: [id])

  @@index([subjectId, levelId])
  @@map("materials")
}

/// `assignments_work` — homework tasks. Named to avoid collision with the
/// teacher↔learner `assignments` relation in §5.1.
model WorkAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  targetLearnerId String? @map("target_learner_id") @db.Uuid
  targetCohortId  String? @map("target_cohort_id") @db.Uuid
  title        String   @db.VarChar(300)
  instructions String   @db.Text
  dueAt        DateTime @map("due_at") @db.Timestamptz(6)
  maxScore     Int      @map("max_score")
  /// The deadline that closes submission entirely, distinct from `dueAt`.
  ///
  /// Work can be handed in after `dueAt` and is marked late (FR-HWK-004). Once
  /// `locksAt` passes nothing can be handed in at all, which is the brief's
  /// "the group automatically locks". Null means the exercise never locks.
  locksAt      DateTime? @map("locks_at") @db.Timestamptz(6)
  /// Reopening is an act with an owner. Only a teacher who set the exercise or an
  /// admin may do it, and the audit trail carries both.
  unlockedBy   String?   @map("unlocked_by") @db.Uuid
  unlockedAt   DateTime? @map("unlocked_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher     Teacher      @relation(fields: [teacherId], references: [userId])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  submissions Submission[]
  unlocker    User?        @relation("ExerciseUnlocker", fields: [unlockedBy], references: [id])
  groupScores GroupScore[]

  @@index([dueAt])
  @@index([locksAt])
  @@map("assignments_work")
}

/// `group_scores` — one mark awarded to a whole group for a shared exercise.
///
/// Not a `Grade`: a `Grade` hangs off a `Submission`, which is one learner's
/// work. Writing a group mark as a Grade per member would mean inventing a
/// Submission for every learner who handed nothing in, turning "did not submit"
/// into "submitted, empty" for the whole cohort.
model GroupScore {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  cohortId     String   @db.Uuid
  score        Int
  note         String?  @db.Text
  awardedBy    String   @db.Uuid
  awardedAt    DateTime @default(now()) @db.Timestamptz(6)

  assignment WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cohort     Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  awarder    User           @relation("GroupScoreAwarder", fields: [awardedBy], references: [id])

  /// Re-marking updates the mark rather than stacking a second one nobody can
  /// choose between.
  @@unique([assignmentId, cohortId])
  @@map("group_scores")
}

model Submission {
  id            String    @id @default(uuid()) @db.Uuid
  assignmentId  String    @map("assignment_id") @db.Uuid
  learnerId     String    @map("learner_id") @db.Uuid
  bodyText      String?   @map("body_text") @db.Text
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// FR-HWK-004: lateness is derived against the due date and recorded.
  isLate        Boolean   @default(false) @map("is_late")
  /// FR-HWK-005: all versions are retained.
  version       Int       @default(1)

  assignment WorkAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learner    Learner          @relation(fields: [learnerId], references: [id])
  files      SubmissionFile[]
  grade      Grade?

  @@index([assignmentId, learnerId])
  @@map("submissions")
}

model SubmissionFile {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(300)
  storageKey   String   @map("storage_key") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  scanStatus   String   @default("pending") @map("scan_status") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_files")
}

model Grade {
  id               String    @id @default(uuid()) @db.Uuid
  submissionId     String    @unique @map("submission_id") @db.Uuid
  score            Int
  feedbackText     String?   @map("feedback_text") @db.Text
  feedbackAudioKey String?   @map("feedback_audio_key") @db.VarChar(500)
  annotationsKey   String?   @map("annotations_key") @db.VarChar(500)
  gradedBy         String    @map("graded_by") @db.Uuid
  gradedAt         DateTime  @default(now()) @map("graded_at") @db.Timestamptz(6)
  /// FR-ASM-010: an override records reason and identity.
  overriddenBy     String?   @map("overridden_by") @db.Uuid
  overrideReason   String?   @map("override_reason") @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("grades")
}

/// `assessments` — quizzes and timed mock examinations (FR-ASM-004/005).
model Assessment {
  id              String         @id @default(uuid()) @db.Uuid
  subjectId       String         @map("subject_id") @db.Uuid
  /// Which class this is set for. Null for the past-paper library, which is
  /// offered to anyone taking the subject rather than set by a teacher.
  levelId         String?        @map("level_id") @db.Uuid
  /// Narrower still: one group inside the level.
  cohortId        String?        @map("cohort_id") @db.Uuid
  title           String         @db.VarChar(300)
  type            AssessmentType
  durationMin     Int?           @map("duration_min")
  shuffleQuestions Boolean       @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean       @default(false) @map("shuffle_options")
  attemptsAllowed  Int           @default(1) @map("attempts_allowed")
  /// `immediate` | `deferred`
  releasePolicy    String        @default("immediate") @map("release_policy") @db.VarChar(20)
  opensAt          DateTime?     @map("opens_at") @db.Timestamptz(6)
  closesAt         DateTime?     @map("closes_at") @db.Timestamptz(6)
  /// Null while the teacher is still writing it. A draft exam is invisible to
  /// every learner, and a timestamp answers "published when" as well as
  /// "published at all" — which a boolean cannot.
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  /// FR-ASM-004: a deferred exam is marked but withheld until the teacher has
  /// read the structural answers and released the lot.
  resultsReleasedAt DateTime?    @map("results_released_at") @db.Timestamptz(6)
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  subject   Subject    @relation(fields: [subjectId], references: [id])
  level     Level?     @relation(fields: [levelId], references: [id])
  cohort    Cohort?    @relation(fields: [cohortId], references: [id])
  questions Question[]
  attempts  Attempt[]

  @@index([levelId, publishedAt])
  @@index([createdBy])
  @@map("assessments")
}

/// `report_cards` — a termly report for one learner.
///
/// The one concept BUILD-PLAN named as genuinely absent. `Grade` is a single mark
/// for a single piece of work; this is many subjects with coefficients, a
/// weighted average and a position in the class.
model ReportCard {
  id           String   @id @default(uuid()) @db.Uuid
  learnerId    String   @db.Uuid
  levelId      String   @db.Uuid
  /// `term_1` | `term_2` | `term_3`. A varchar rather than an enum: not every
  /// Cameroonian school runs three terms, and an enum would need a migration to
  /// find that out.
  term         String   @db.VarChar(20)
  academicYear String   @db.VarChar(20)
  /// Stored, not recomputed on read. The average a family was shown in December
  /// must not change because a mark was edited in March — a regeneration writes
  /// the row again, deliberately and with an owner.
  averageMark  Decimal? @db.Decimal(5, 2)
  totalCoefficient Int  @default(0)
  classPosition    Int?
  classSize        Int?
  remark       String?  @db.Text
  generatedBy  String?  @db.Uuid
  generatedAt  DateTime @default(now()) @db.Timestamptz(6)
  /// Generated and published are separate acts: a report card is checked before a
  /// family sees it.
  publishedAt  DateTime? @db.Timestamptz(6)

  learner   Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  level     Level            @relation(fields: [levelId], references: [id])
  generator User?            @relation("ReportCardGenerator", fields: [generatedBy], references: [id])
  lines     ReportCardLine[]

  @@unique([learnerId, term, academicYear])
  @@index([levelId, term, academicYear])
  @@map("report_cards")
}

model ReportCardLine {
  id           String   @id @default(uuid()) @db.Uuid
  reportCardId String   @db.Uuid
  subjectId    String   @db.Uuid
  mark         Decimal  @db.Decimal(5, 2)
  /// The Cameroonian coefficient: Maths at 4 counts four times a subject at 1.
  coefficient  Int      @default(1)
  teacherId    String?  @db.Uuid
  comment      String?  @db.Text
  submittedAt  DateTime @default(now()) @db.Timestamptz(6)

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    Teacher?   @relation(fields: [teacherId], references: [userId])

  @@unique([reportCardId, subjectId])
  @@map("report_card_lines")
}

/// `subject_term_marks` — a mark a teacher has entered, before any report card
/// exists.
///
/// The brief's "after all the teachers have submitted their reports, one click
/// generates every report card" needs somewhere for a mark to sit in between, and
/// it is not the report card: generating one is a whole-class calculation that
/// cannot run until every subject is in.
model SubjectTermMark {
  id           String   @id @default(uuid()) @db.Uuid
  learnerId    String   @db.Uuid
  subjectId    String   @db.Uuid
  teacherId    String   @db.Uuid
  levelId      String   @db.Uuid
  term         String   @db.VarChar(20)
  academicYear String   @db.VarChar(20)
  mark         Decimal  @db.Decimal(5, 2)
  coefficient  Int      @default(1)
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([learnerId, subjectId, term, academicYear])
  @@index([levelId, term, academicYear])
  @@index([teacherId])
  @@map("subject_term_marks")
}

model Question {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @map("assessment_id") @db.Uuid
  type         QuestionType
  prompt       String       @db.Text
  topic        String?      @db.VarChar(200)
  marks        Int          @default(1)
  /// FR-ASM-009: answer keys are server-side only and are never sent to the
  /// client before release.
  answerKey    Json?        @map("answer_key")
  tolerance    Decimal?     @db.Decimal(10, 4)
  sortOrder    Int          @map("sort_order")
  sectionName  String?      @map("section_name") @db.VarChar(200)

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    QuestionOption[]
  answers    Answer[]

  @@index([assessmentId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String  @db.Text
  /// Never serialised to the client before release (FR-ASM-009).
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @map("sort_order")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Attempt {
  id           String    @id @default(uuid()) @db.Uuid
  assessmentId String    @map("assessment_id") @db.Uuid
  learnerId    String    @map("learner_id") @db.Uuid
  /// FR-ASM-007: remaining time is computed server-side from this timestamp.
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  score        Int?
  percentage   Decimal?  @db.Decimal(5, 2)
  perTopicJson Json?     @map("per_topic_json")
  timeTakenSec Int?      @map("time_taken_sec")
  autoSubmitted Boolean  @default(false) @map("auto_submitted")
  /// §4.3. `flagged_for_review` is reached by three noise flags and means a
  /// human will look; it does not mean the attempt ended. The attempt submits
  /// normally and every answer is kept.
  state        AttemptState @default(in_progress)
  /// FR-ASM-010: an overridden mark is shown as overridden, never silently
  /// swapped for the original.
  overriddenBy String?   @map("overridden_by") @db.Uuid
  overriddenAt DateTime? @map("overridden_at") @db.Timestamptz(6)
  /// §4.2.1: a proctored attempt by a minor requires recorded guardian consent.
  /// Null means the attempt was taken unproctored, which is the offered
  /// alternative rather than a failure state.
  proctored    Boolean   @default(false)
  consentId    String?   @map("consent_id") @db.Uuid
  /// The exam was stopped by the system — the third noise flag, or a mic or
  /// camera that went off and stayed off.
  ///
  /// Stopping is not deciding. Everything answered up to this instant is
  /// submitted and kept (FR-ASM-007), the attempt lands in `flagged_for_review`,
  /// and what the paper is worth remains a human's call (FR-AI-005). There is
  /// still no path by which the system zeroes or voids a script.
  terminatedAt     DateTime? @map("terminated_at") @db.Timestamptz(6)
  /// `noise_flag_limit` | `mic_off` | `camera_off`.
  terminationReason String?  @map("termination_reason") @db.VarChar(30)

  assessment  Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner     Learner          @relation(fields: [learnerId], references: [id])
  answers     Answer[]
  deviceCheck ExamDeviceCheck?
  proctorEvents ProctorEvent[]
  proctorFlags  ProctorFlag[]
  reviews       AttemptReview[]

  @@index([learnerId, assessmentId])
  /// The review queue reads attempts by state, oldest first.
  @@index([state, submittedAt])
  @@map("attempts")
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  attemptId  String   @map("attempt_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  response   Json?
  awarded    Int?
  markedBy   String?  @map("marked_by") @db.Uuid
  comment    String?  @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answers")
}

/// `past_papers` — the GCE library (FR-GCE-002).
model PastPaper {
  id        String         @id @default(uuid()) @db.Uuid
  levelId   String         @map("level_id") @db.Uuid
  subjectId String         @map("subject_id") @db.Uuid
  boardLevel ExamBoardLevel @map("board_level")
  year      Int
  paperNo   Int            @map("paper_no")
  storageKey String        @map("storage_key") @db.VarChar(500)
  modelAnswerKey String?   @map("model_answer_key") @db.VarChar(500)
  /// FR-GCE-007 / AS-05 / OI-05: an item with no recorded right is not publishable.
  source       String       @db.VarChar(300)
  rightsStatus RightsStatus @default(unverified) @map("rights_status")
  publishable  Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  level   Level   @relation(fields: [levelId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId, year])
  @@map("past_papers")
}

// ---------------------------------------------------------------------------
// §5.1 — Money
// ---------------------------------------------------------------------------

/// `plans` — subscription products (FR-PAY-001/002).
model Plan {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique @db.VarChar(50)
  nameEn     String        @map("name_en") @db.VarChar(150)
  nameFr     String        @map("name_fr") @db.VarChar(150)
  levelScope String        @map("level_scope") @db.VarChar(50)
  period     BillingPeriod
  /// CON-02 / DAT-002: whole XAF as BigInt. Never a float.
  priceXaf   BigInt        @map("price_xaf")
  /// OI-03: entitlements are undefined in the brief. Held as configurable JSON so
  /// the commercial decision can land without a schema change.
  entitlementsJson Json    @map("entitlements_json")
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

/// `subscriptions` — a learner's entitlement for one period (FR-PAY-003/007).
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  learnerId   String             @map("learner_id") @db.Uuid
  payerUserId String             @map("payer_user_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  periodStart DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime           @map("period_end") @db.Timestamptz(6)
  status      SubscriptionStatus @default(pending_payment)
  /// FR-PAY-007: configurable grace period, default 3 days.
  graceUntil  DateTime?          @map("grace_until") @db.Timestamptz(6)
  /// Remaining entitlement counters, decremented at booking (FR-PAY-006).
  entitlementStateJson Json?     @map("entitlement_state_json")
  cancelledAt DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  learner  Learner   @relation(fields: [learnerId], references: [id])
  payer    User      @relation("SubscriptionPayer", fields: [payerUserId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
  /// §5.1: instalments are a payment schedule attached to a subscription, reusing
  /// the FR-PAY-007 state machine rather than inventing a parallel one.
  schedule PaymentSchedule?

  /// DAT-004: one subscription per learner per period.
  @@unique([learnerId, periodStart])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

/// `payments` — collection attempts. State model per Appendix B.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  method         PaymentMethod
  /// DAT-004 / FR-PAY-013: retries with the same key never produce a second debit.
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(100)
  providerRef    String?       @map("provider_ref") @db.VarChar(200)
  amountXaf      BigInt        @map("amount_xaf")
  feeXaf         BigInt        @default(0) @map("fee_xaf")
  taxXaf         BigInt        @default(0) @map("tax_xaf")
  status         PaymentStatus @default(initiated)
  failureReason  String?       @map("failure_reason") @db.VarChar(500)
  /// FR-PAY-012: polling continues until a terminal state or timeout.
  lastPolledAt   DateTime?     @map("last_polled_at") @db.Timestamptz(6)
  pollAttempts   Int           @default(0) @map("poll_attempts")
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(6)

  /// §4.7.2: a Finance Admin may record a payment taken outside the platform.
  /// Reason and evidence are mandatory at the API, and it still produces ledger
  /// entries — it is a recorded collection, not a state edit.
  recordedOffline Boolean  @default(false) @map("recorded_offline")
  recordedBy      String?  @map("recorded_by") @db.Uuid
  recordReason    String?  @map("record_reason") @db.Text
  evidenceKey     String?  @map("evidence_key") @db.VarChar(500)

  /// FR-PAY-017: a refund is its own payment row pointing at what it reverses,
  /// so the collection history is never rewritten.
  refundOfPaymentId String? @map("refund_of_payment_id") @db.Uuid
  refundReason      String? @map("refund_reason") @db.Text
  refundedBy        String? @map("refunded_by") @db.Uuid

  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  refundOf     Payment?      @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id])
  refunds      Payment[]     @relation("PaymentRefund")
  instalments  Instalment[]
  invoice      Invoice?
  reconciliationItems ReconciliationItem[]

  @@index([status, createdAt])
  @@index([providerRef])
  @@map("payments")
}

/// `ledger_entries` — append-only double-entry record (FR-LDG-001/002).
/// DAT-005: UPDATE and DELETE are revoked from the application role.
model LedgerEntry {
  id         String          @id @default(uuid()) @db.Uuid
  /// Both legs of a movement share a txnId and must sum to zero.
  txnId      String          @map("txn_id") @db.Uuid
  account    String          @db.VarChar(100)
  direction  LedgerDirection
  amountXaf  BigInt          @map("amount_xaf")
  currency   String          @default("XAF") @db.VarChar(3)
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz(6)
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([txnId])
  @@index([account, occurredAt])
  @@map("ledger_entries")
}

/// `earnings` — teacher accrual for a period (FR-ERN-002/003/006).
model Earning {
  id              String   @id @default(uuid()) @db.Uuid
  teacherId       String   @map("teacher_id") @db.Uuid
  /// Accrual period as `YYYY-MM`.
  period          String   @db.VarChar(7)
  attendedMinutes Int      @map("attended_minutes")
  /// §4.7.5: the one-to-one / group split, kept separately because the two carry
  /// different configurable weights (FR-ERN-003).
  oneToOneMinutes Int      @default(0) @map("one_to_one_minutes")
  groupMinutes    Int      @default(0) @map("group_minutes")
  amountXaf       BigInt   @map("amount_xaf")
  deductionsXaf   BigInt   @default(0) @map("deductions_xaf")
  /// Gross minus deductions. Stored rather than derived so a payout reconciles
  /// against exactly the figure that was approved.
  netPayableXaf   BigInt   @default(0) @map("net_payable_xaf")
  /// OI-02: the split, the basis and the session weights are configuration read
  /// at calculation time. The version used is stored on the record so a
  /// historical calculation stays reproducible after the configuration changes.
  configVersion   String   @map("config_version") @db.VarChar(64)
  /// FR-ERN-006: every figure traces to the sessions that produced it.
  basisJson       Json     @map("basis_json")
  payoutId        String?  @map("payout_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [userId])
  payout  Payout? @relation(fields: [payoutId], references: [id])

  @@unique([teacherId, period])
  @@index([period])
  @@map("earnings")
}

/// `payouts` — money out (FR-ERN-007/008/010).
model Payout {
  id          String        @id @default(uuid()) @db.Uuid
  teacherId   String        @map("teacher_id") @db.Uuid
  amountXaf   BigInt        @map("amount_xaf")
  method      PaymentMethod
  providerRef String?       @map("provider_ref") @db.VarChar(200)
  /// FR-ERN-008: payouts require Finance Admin approval and are idempotent.
  idempotencyKey String     @unique @map("idempotency_key") @db.VarChar(100)
  status      PayoutStatus  @default(requested)
  approvedBy  String?       @map("approved_by") @db.Uuid
  approvedAt  DateTime?     @map("approved_at") @db.Timestamptz(6)
  executedAt  DateTime?     @map("executed_at") @db.Timestamptz(6)
  failureReason String?     @map("failure_reason") @db.VarChar(500)
  withheldTaxXaf BigInt     @default(0) @map("withheld_tax_xaf")
  providerFeeXaf BigInt     @default(0) @map("provider_fee_xaf")
  /// §4.7.4: where a suspended teacher has accrued earnings the money is held,
  /// not forfeited. A held payout waits for a named human decision (FR-AI-005).
  heldReason  String?       @map("held_reason") @db.Text
  /// The accrual period this payout settles, so §4.7.3 can link every figure
  /// through to the sessions that produced it.
  period      String?       @db.VarChar(7)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher  Teacher   @relation(fields: [teacherId], references: [userId])
  earnings Earning[]

  @@index([teacherId, status])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// §5.1 — Communication, support and governance
// ---------------------------------------------------------------------------

/// `notifications` — sent messages (FR-NOT-006).
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  eventType   String              @map("event_type") @db.VarChar(100)
  channel     NotificationChannel
  template    String              @db.VarChar(100)
  language    Language
  status      NotificationStatus  @default(queued)
  /// FR-NOT-005: deduplication key across channels for one logical event.
  dedupeKey   String?             @map("dedupe_key") @db.VarChar(200)
  payloadJson Json?               @map("payload_json")
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime?           @map("delivered_at") @db.Timestamptz(6)
  failureReason String?           @map("failure_reason") @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([dedupeKey])
  @@map("notifications")
}

/// FR-NOT-002: the notification catalogue — default channels, priority,
/// EN and FR templates, and whether the user may disable it.
model NotificationTemplate {
  id             String                @id @default(uuid()) @db.Uuid
  eventType      String                @unique @map("event_type") @db.VarChar(100)
  defaultChannels NotificationChannel[] @map("default_channels")
  priority       String                @db.VarChar(20)
  /// FR-NOT-003: transactional and safety notifications are not disableable.
  userDisableable Boolean              @default(true) @map("user_disableable")
  subjectEn      String?               @map("subject_en") @db.VarChar(300)
  subjectFr      String?               @map("subject_fr") @db.VarChar(300)
  bodyEn         String                @map("body_en") @db.Text
  bodyFr         String                @map("body_fr") @db.Text
  /// FR-NOT-007 / SI-008: WhatsApp sends outside the 24h window need an approved template.
  whatsappTemplateName String?         @map("whatsapp_template_name") @db.VarChar(150)

  @@map("notification_templates")
}

/// FR-NOT-004: per-user channel choices and quiet hours (default 21:00–06:00).
model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(100)
  channels  NotificationChannel[]
  enabled   Boolean  @default(true)
  quietStart String? @map("quiet_start") @db.VarChar(5)
  quietEnd   String? @map("quiet_end") @db.VarChar(5)

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

/// `tickets` — support requests (FR-SUP-003).
model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  requesterId String         @map("requester_id") @db.Uuid
  category    TicketCategory @default(general)
  priority    TicketPriority @default(normal)
  status      TicketStatus   @default(open)
  subject     String         @db.VarChar(300)
  /// FR-SUP-001: in-app chat, WhatsApp or email.
  channel     TicketChannel  @default(in_app)
  assigneeId  String?        @map("assignee_id") @db.Uuid
  assignedBy  String?        @map("assigned_by") @db.Uuid
  assignedAt  DateTime?      @map("assigned_at") @db.Timestamptz(6)
  /// FR-SUP-004: context captured at creation time.
  contextJson Json?          @map("context_json")
  firstResponseAt DateTime?  @map("first_response_at") @db.Timestamptz(6)
  /// FR-SUP-006: first-response and resolution targets are configurable, and the
  /// deadline is stamped at creation so the countdown survives a config change.
  firstResponseDueAt DateTime? @map("first_response_due_at") @db.Timestamptz(6)
  resolutionDueAt    DateTime? @map("resolution_due_at") @db.Timestamptz(6)
  escalatedAt        DateTime? @map("escalated_at") @db.Timestamptz(6)
  /// FR-NOT-007 / R7: outside this instant a WhatsApp reply must use a
  /// pre-approved template. Null for any other channel.
  whatsappWindowEndsAt DateTime? @map("whatsapp_window_ends_at") @db.Timestamptz(6)
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages  TicketMessage[]
  safeguardingReport SafeguardingReport?

  @@index([status, priority])
  @@index([assigneeId, status])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

/// `reviews` — teacher ratings (FR-RAT-001/003).
model Review {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  raterId          String           @map("rater_id") @db.Uuid
  teacherId        String           @map("teacher_id") @db.Uuid
  stars            Int
  comment          String?          @db.Text
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  teacherResponse  String?          @map("teacher_response") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater   User    @relation("ReviewRater", fields: [raterId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [userId])

  @@unique([sessionId, raterId])
  @@index([teacherId, moderationStatus])
  @@map("reviews")
}

/// `audit_log` — immutable trail (FR-RBA-004).
/// DAT-005: UPDATE and DELETE are revoked from the application role.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  /// NFR-MNT-005: correlation IDs span client, API and workers.
  correlationId String? @map("correlation_id") @db.VarChar(100)
  /// FR-RBA-005: an impersonation ("view as") session records its reason.
  reason     String?  @db.Text
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, occurredAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

/// `consents` — recorded permissions (FR-SAF-009, NFR-PRV-002/003).
model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  consentType ConsentType @map("consent_type")
  /// Set where the consent is given by a Guardian on behalf of a learner.
  learnerId   String?     @map("learner_id") @db.Uuid
  grantedAt   DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(6)
  /// Evidence: document version, IP, user agent.
  evidence    Json?
  version     String      @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  /// The approval checks look a consent up by guardian, learner and type.
  @@index([userId, learnerId, consentType])
  @@map("consents")
}

/// FR-RBA-005: time-boxed, read-only "view as" grants, individually logged.
model ImpersonationGrant {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  reason      String    @db.Text
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([staffUserId, expiresAt])
  @@map("impersonation_grants")
}

// ---------------------------------------------------------------------------
// §5 of the admin brief — instalment billing and automatic account freezing
// ---------------------------------------------------------------------------

/// `payment_schedules` — how a subscription's total fee is to be collected.
///
/// §5.1: the payer chooses pay-in-full or pay-in-3. Instalment amounts and dates
/// come from plan configuration and are visible before commitment (UI-007).
model PaymentSchedule {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @unique @map("subscription_id") @db.Uuid
  planType       InstalmentPlanType @map("plan_type")
  /// CON-02: whole XAF. §5.1 requires the instalments to sum exactly to this.
  totalXaf       BigInt             @map("total_xaf")
  /// The one-off registration fee, separate from tuition.
  ///
  /// Registration and tuition are different debts: a family pays to enrol, then
  /// pays to be taught. Folding the first into the instalments made "Part 1"
  /// mean two different things and made the plan total unexplainable to the
  /// person paying it. `total_xaf` is tuition only; this sits beside it.
  registrationFeeXaf BigInt   @default(0) @map("registration_fee_xaf")
  registrationPaidAt DateTime? @map("registration_paid_at") @db.Timestamptz(6)
  /// OI-03/Q3: a pay-in-full discount is configuration, defaulting to zero.
  discountXaf    BigInt             @default(0) @map("discount_xaf")
  /// §5.1: settling the balance clears all future instalments and lifts any
  /// automatic freeze immediately.
  settledInFullAt DateTime?         @map("settled_in_full_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  instalments  Instalment[]

  @@map("payment_schedules")
}

/// `instalments` — one part of a schedule. §5.2.
model Instalment {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @map("schedule_id") @db.Uuid
  /// 1, 2 or 3. §5.3 applies the freeze rule independently at each.
  sequence   Int
  amountXaf  BigInt          @map("amount_xaf")
  /// Stored as a date: a due date is a calendar fact in Africa/Douala, not an
  /// instant. The grace deadline is derived from it at UTC midnight + offset.
  dueOn      DateTime        @map("due_on") @db.Date
  state      InstalmentState @default(scheduled)
  paidAt     DateTime?       @map("paid_at") @db.Timestamptz(6)
  /// Set when an Admin moved this instalment's state without a payment — a
  /// correction, a waiver, a scholarship. Kept beside the state so the row
  /// itself says it was adjusted rather than collected, and by whom.
  adjustedBy       String? @map("adjusted_by") @db.Uuid
  adjustmentReason String? @map("adjustment_reason") @db.VarChar(500)
  paymentId  String?         @map("payment_id") @db.Uuid
  /// FR-PAY-019 / §5.3: which of the 7/3/1/0/freeze-day notices have gone out,
  /// so a restart or a re-run never sends the same notice twice.
  noticesSentJson Json?      @map("notices_sent_json")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  payment  Payment?        @relation(fields: [paymentId], references: [id])
  freezes  AccountFreeze[]

  @@unique([scheduleId, sequence])
  @@index([state, dueOn])
  @@map("instalments")
}

/// `account_freezes` — a suspension of service, never a deletion of data (§5.4).
///
/// FR-RBA-004: every automatic and manual freeze and unfreeze is audited with
/// actor, reason, timestamp and IP; the audit row carries the triggering
/// instalment ID. This table is the operational state behind that trail.
model AccountFreeze {
  id       String         @id @default(uuid()) @db.Uuid
  scope    FreezeScope
  /// Exactly one of these is set, matching `scope`.
  learnerId     String?   @map("learner_id") @db.Uuid
  teacherUserId String?   @map("teacher_user_id") @db.Uuid

  kind     FreezeKind
  category FreezeCategory
  /// Mandatory and free-text for a manual freeze; the rule text for an automatic one.
  reason   String         @db.Text
  /// §5.3: set for an automatic freeze so the trail names the missed instalment.
  triggeringInstalmentId String? @map("triggering_instalment_id") @db.Uuid

  /// §5.4: never freeze mid-session. A freeze that becomes due while the learner
  /// is in a live class is written now and takes effect at session end, so the
  /// decision is recorded at the moment it was made.
  appliedAt     DateTime  @default(now()) @map("applied_at") @db.Timestamptz(6)
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  deferredForSessionId String? @map("deferred_for_session_id") @db.Uuid

  liftedAt     DateTime? @map("lifted_at") @db.Timestamptz(6)
  liftedBy     String?   @map("lifted_by") @db.Uuid
  liftReason   String?   @map("lift_reason") @db.Text
  createdBy    String?   @map("created_by") @db.Uuid

  learner    Learner?    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  teacher    Teacher?    @relation(fields: [teacherUserId], references: [userId], onDelete: Cascade)
  instalment Instalment? @relation(fields: [triggeringInstalmentId], references: [id])

  @@index([learnerId, liftedAt])
  @@index([teacherUserId, liftedAt])
  @@map("account_freezes")
}

// ---------------------------------------------------------------------------
// §4.6 of the admin brief — safeguarding
// ---------------------------------------------------------------------------

/// `safeguarding_reports` — the restricted queue.
///
/// FR-SAF-006: visible only to designated staff, and nothing here is ever
/// deleted by an operator. FR-SAF-005: first response within 4 hours.
model SafeguardingReport {
  id        String             @id @default(uuid()) @db.Uuid
  source    SafeguardingSource
  reporterId String?           @map("reporter_id") @db.Uuid
  /// Who or what the report is about.
  subjectTeacherId String?     @map("subject_teacher_id") @db.Uuid
  subjectLearnerId String?     @map("subject_learner_id") @db.Uuid
  relatedSessionId String?     @map("related_session_id") @db.Uuid
  /// A safeguarding ticket never appears in the general support pool
  /// (FR-SUP-007); when one arrives by ticket it is linked here and hidden there.
  ticketId  String?            @unique @map("ticket_id") @db.Uuid

  summary   String             @db.Text
  /// Links to recordings, message threads and files. Retained in full.
  evidenceJson Json?           @map("evidence_json")

  state     SafeguardingState  @default(open)
  assignedTo String?           @map("assigned_to") @db.Uuid
  /// FR-SAF-005: stamped at creation from the configurable 4-hour target.
  firstResponseDueAt DateTime  @map("first_response_due_at") @db.Timestamptz(6)
  firstResponseAt    DateTime? @map("first_response_at") @db.Timestamptz(6)
  /// A named human decision-maker, per FR-AI-005.
  actionTaken   String?        @map("action_taken") @db.Text
  decidedBy     String?        @map("decided_by") @db.Uuid
  closedAt      DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher? @relation(fields: [subjectTeacherId], references: [userId])
  ticket  Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([state, firstResponseDueAt])
  @@map("safeguarding_reports")
}

/// `redaction_flags` — FR-SAF-002. Repeated attempts by a teacher to pass a
/// phone number, email or social handle to a minor surface on the safeguarding
/// queue. The excerpt is stored already redacted: the evidence is that a
/// contact detail was sent, not the detail itself.
model RedactionFlag {
  id         String        @id @default(uuid()) @db.Uuid
  teacherId  String        @map("teacher_id") @db.Uuid
  learnerId  String?       @map("learner_id") @db.Uuid
  kind       RedactionKind
  excerptRedacted String   @map("excerpt_redacted") @db.Text
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reportId   String?       @map("report_id") @db.Uuid

  teacher Teacher  @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  learner Learner? @relation(fields: [learnerId], references: [id])

  @@index([teacherId, occurredAt])
  @@map("redaction_flags")
}

// ---------------------------------------------------------------------------
// §4.7.6 of the admin brief — reconciliation, and §4.7.1 — invoices
// ---------------------------------------------------------------------------

/// `reconciliation_runs` — one daily comparison against one provider's
/// settlement report (FR-LDG-003).
model ReconciliationRun {
  id            String   @id @default(uuid()) @db.Uuid
  provider      PaymentMethod
  statementDate DateTime @map("statement_date") @db.Date
  itemCount     Int      @default(0) @map("item_count")
  unmatchedCount Int     @default(0) @map("unmatched_count")
  unmatchedValueXaf BigInt @default(0) @map("unmatched_value_xaf")
  /// FR-LDG-004: set when the run crossed the configurable alert threshold.
  alertedAt     DateTime? @map("alerted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  items ReconciliationItem[]

  @@unique([provider, statementDate])
  @@map("reconciliation_runs")
}

model ReconciliationItem {
  id          String              @id @default(uuid()) @db.Uuid
  runId       String              @map("run_id") @db.Uuid
  provider    PaymentMethod
  providerRef String              @map("provider_ref") @db.VarChar(200)
  amountXaf   BigInt              @map("amount_xaf")
  occurredAt  DateTime            @map("occurred_at") @db.Timestamptz(6)
  paymentId   String?             @map("payment_id") @db.Uuid
  state       ReconciliationState @default(unmatched)
  note        String?             @db.Text
  /// FR-AI-005: writing an item off is discretionary, so it names a human.
  resolvedBy  String?             @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(6)

  run     ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  payment Payment?          @relation(fields: [paymentId], references: [id])

  @@index([state, occurredAt])
  @@map("reconciliation_items")
}

/// `invoices` — FR-PAY-016: every successful collection produces a numbered
/// invoice. The number is allocated from a gapless sequence, because a tax
/// authority reads a gap as a deleted document.
model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  number    String   @unique @db.VarChar(40)
  paymentId String   @unique @map("payment_id") @db.Uuid
  totalXaf  BigInt   @map("total_xaf")
  taxXaf    BigInt   @default(0) @map("tax_xaf")
  /// OI-07: the legal fields a Cameroonian invoice must carry are unresolved, so
  /// they are held as configuration-driven JSON rather than fixed columns.
  legalFieldsJson Json? @map("legal_fields_json")
  storageKey String? @map("storage_key") @db.VarChar(500)
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

/// `unallocated_pool` — FR-ERN-004.
///
/// Where a learner attended no sessions in a period, their pool share is not
/// swept into platform revenue. It lands here with a balance and waits for a
/// named Admin decision.
model UnallocatedPool {
  id        String              @id @default(uuid()) @db.Uuid
  period    String              @unique @db.VarChar(7)
  amountXaf BigInt              @map("amount_xaf")
  /// Which learners contributed, so the decision is made on evidence.
  basisJson Json                @map("basis_json")
  decision  UnallocatedDecision @default(pending)
  decidedBy String?             @map("decided_by") @db.Uuid
  decidedAt DateTime?           @map("decided_at") @db.Timestamptz(6)
  reason    String?             @db.Text
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("unallocated_pool")
}

/// `support_agent_profiles` — §4.5's agent panel needs a presence state and a
/// workload ceiling that are not properties of the underlying user account.
model SupportAgentProfile {
  userId         String        @id @map("user_id") @db.Uuid
  presence       AgentPresence @default(offline)
  lastSeenAt     DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  maxOpenTickets Int           @default(25) @map("max_open_tickets")
  /// FR-SAF-006: safeguarding visibility is a per-person designation, not a role
  /// level. A super_admin who is not designated still does not see the queue.
  safeguardingDesignated Boolean @default(false) @map("safeguarding_designated")

  @@map("support_agent_profiles")
}

/// Runtime configuration. Anything the SRS calls "configurable" lives here so
/// that changing it is a configuration change, not a deployment (CON-07).
model PlatformConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.Text
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_config")
}

// ---------------------------------------------------------------------------
// §4.5 live participation, §4.6 proctoring, §4.10 messaging
//
// OI-04 is still open, so nothing here names a media vendor. These models
// record what the platform decided and what it observed; the provider that
// enforces it sits behind a port in the API.
// ---------------------------------------------------------------------------

/// Why a microphone or camera was off.
///
/// The distinction is the whole point. FR-LIV-009 has the classroom disable
/// learner video automatically as bandwidth falls, and FR-LIV-010 offers an
/// audio-only save-data mode. A learner on 3G in a shared household is off
/// camera because the platform switched it off, not because they chose to hide.
/// Reporting the two as one number attributes a system decision to a child.
enum StreamOffReason {
  learner_choice
  system_bandwidth
  system_policy
  device_failure
}

enum MediaPublishRequestState {
  pending
  approved
  dismissed
  withdrawn
  revoked
}

/// FR-AI-005 forbids an automated final decision that materially affects a
/// person. There is deliberately no `voided_by_system` member: the only route
/// to a void is `voided_by_human`, which requires a named reviewer.
enum AttemptState {
  in_progress
  submitted
  flagged_for_review
  under_review
  released
  voided_by_human
}

/// Degradations and interruptions during a proctored attempt, logged so a human
/// reviewer sees what the conditions actually were.
enum ProctorEventKind {
  device_check_passed
  camera_degraded_to_still_frames
  camera_disabled
  camera_failed
  camera_restored
  mic_failed
  mic_disabled
  mic_restored
  bandwidth_drop
  disconnected
  resumed
  /// The system stopped the exam. Logged so a reviewer sees the trigger.
  terminated_by_system
}

enum ProctorFlagKind {
  sustained_background_noise
}

/// FR-SAF-008: learner-to-learner is absent by construction. A thread has no
/// kind that could express it, so the endpoint has nothing to route to.
enum MessageThreadKind {
  learner_teacher
  learner_support
  guardian_teacher
  /// A teacher and ClassConnect. Deliberately not `learner_support`: that queue
  /// is about a child, carries a `learner_id` and is worked under safeguarding
  /// rules, and a teacher asking about a payout does not belong in it.
  teacher_support
}

enum MessageState {
  visible
  deleted
}

/// `media_publish_requests` — "ask to speak" (FR-LIV-005/008, SI-005).
///
/// The row is the authority. A learner publishes because a teacher approved a
/// request and the media service minted a token scoped to this session; no
/// client-side flag grants it, so modified local state achieves nothing.
model MediaPublishRequest {
  id            String                   @id @default(uuid()) @db.Uuid
  sessionId     String                   @map("session_id") @db.Uuid
  learnerUserId String                   @map("learner_user_id") @db.Uuid
  state         MediaPublishRequestState @default(pending)
  /// FR-LIV-005: sharing a screen is a separate grant, not implied by speaking.
  screenShare   Boolean                  @default(false) @map("screen_share")
  requestedAt   DateTime                 @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt     DateTime?                @map("decided_at") @db.Timestamptz(6)
  /// The teacher who approved or dismissed. Never the learner.
  decidedBy     String?                  @map("decided_by") @db.Uuid
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedBy     String?                  @map("revoked_by") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner User    @relation(fields: [learnerUserId], references: [id])

  /// The teacher's queue reads pending requests for one session, in order.
  @@index([sessionId, state, requestedAt])
  @@map("media_publish_requests")
}

/// `exam_device_checks` — FR-LIV-016, the §4.2 pre-exam gate.
model ExamDeviceCheck {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @unique @map("attempt_id") @db.Uuid
  micWorking        Boolean  @map("mic_working")
  cameraWorking     Boolean  @map("camera_working")
  bandwidthKbps     Int?     @map("bandwidth_kbps")
  /// The learner's acknowledgement of the §4.2.3 disclosure, with the version
  /// of the wording they were actually shown.
  disclosureVersion String   @map("disclosure_version") @db.VarChar(20)
  acknowledgedAt    DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("exam_device_checks")
}

/// `proctor_events` — the degradation ladder of §4.3.
model ProctorEvent {
  id         String           @id @default(uuid()) @db.Uuid
  attemptId  String           @map("attempt_id") @db.Uuid
  kind       ProctorEventKind
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Measured cause, so a reviewer can tell a collapsing link from a covered lens.
  detail     Json?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@map("proctor_events")
}

/// `proctor_flags` — noise flags. Three escalate to a human; none terminates.
///
/// `sequence` is the flag's ordinal within the attempt, which is what drives
/// the §4.3 ladder. It is stored rather than counted at read time, so the
/// notice a learner actually saw is reconstructable afterwards.
model ProctorFlag {
  id                 String          @id @default(uuid()) @db.Uuid
  attemptId          String          @map("attempt_id") @db.Uuid
  kind               ProctorFlagKind @default(sustained_background_noise)
  sequence           Int
  occurredAt         DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// What actually tripped the detector, kept so Q1 can be calibrated against
  /// real attempts rather than guessed a second time.
  peakDb             Decimal?        @map("peak_db") @db.Decimal(6, 2)
  sustainedMs        Int             @map("sustained_ms")
  /// Short audio clip. FR-FIL-001 applies: nothing is served before it scans.
  evidenceKey        String?         @map("evidence_key") @db.VarChar(500)
  evidenceScanStatus String          @default("pending") @map("evidence_scan_status") @db.VarChar(20)
  /// Q3: retention for proctoring evidence is undecided, so the expiry rides on
  /// the row rather than being assumed from the recording policy.
  evidenceUntil      DateTime?       @map("evidence_until") @db.Timestamptz(6)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@index([attemptId, occurredAt])
  @@map("proctor_flags")
}

/// `attempt_reviews` — the human decision FR-AI-005 requires.
model AttemptReview {
  id               String    @id @default(uuid()) @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  openedAt         DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  reviewerId       String?   @map("reviewer_id") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  /// `upheld` | `dismissed` | `voided`. A void requires `reviewerId`.
  outcome          String?   @db.VarChar(20)
  rationale        String?   @db.Text
  /// Q2: the learner is told a review is open and may respond before a decision.
  learnerStatement String?   @map("learner_statement") @db.Text

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([decidedAt])
  @@map("attempt_reviews")
}

/// `recording_playback` — resume where the learner stopped (§3).
model RecordingPlayback {
  recordingId String   @map("recording_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  positionSec Int      @default(0) @map("position_sec")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recordingId, userId])
  @@map("recording_playback")
}

/// `message_threads` — FR-SAF-001: all contact stays inside the platform.
model MessageThread {
  id               String            @id @default(uuid()) @db.Uuid
  kind             MessageThreadKind
  /// The child the thread concerns, which is what gives a guardian its reach
  /// (FR-SAF-003). Null only for a support thread opened by an adult.
  learnerId        String?           @map("learner_id") @db.Uuid
  teacherUserId    String?           @map("teacher_user_id") @db.Uuid
  subjectId        String?           @map("subject_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt    DateTime?         @map("last_message_at") @db.Timestamptz(6)
  /// §5.4: a thread under investigation cannot have messages deleted from it.
  safeguardingHold Boolean           @default(false) @map("safeguarding_hold")

  learner      Learner?            @relation(fields: [learnerId], references: [id])
  messages     Message[]
  participants ThreadParticipant[]

  @@index([learnerId, lastMessageAt])
  @@index([teacherUserId, lastMessageAt])
  @@map("message_threads")
}

model ThreadParticipant {
  threadId String   @map("thread_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  /// A guardian is a participant for reading (FR-SAF-003) without being a party
  /// to the conversation, so posting rights are explicit rather than implied.
  mayPost  Boolean  @default(true) @map("may_post")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// When this participant last opened the thread. Unread is everything after
  /// it, so the count is derived rather than stored — a stored counter drifts
  /// the first time a write fails halfway through.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

/// `messages` — soft delete only.
///
/// DAT-006 and FR-SAF-006 make this append-only in effect: `state` hides a
/// message from the conversation and nothing removes `body`. A silent deletion
/// would let a teacher erase an inappropriate message from a child's view, or a
/// learner erase evidence of harassment, which is exactly what the tombstone
/// prevents. There is no hard-delete path for any role — erasure is a
/// documented data-subject workflow with legal sign-off (NFR-PRV-004).
model Message {
  id           String       @id @default(uuid()) @db.Uuid
  threadId     String       @map("thread_id") @db.Uuid
  senderUserId String       @map("sender_user_id") @db.Uuid
  /// What the recipient sees: FR-SAF-002 redaction already applied.
  body         String       @db.Text
  /// What was actually typed, retained as safeguarding evidence when redaction
  /// changed something. Null when the two would be identical.
  bodyOriginal String?      @map("body_original") @db.Text
  state        MessageState @default(visible)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt     DateTime?    @map("edited_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?      @map("deleted_by") @db.Uuid

  thread      MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderUserId], references: [id])
  attachments MessageAttachment[]
  versions    MessageVersion[]

  @@index([threadId, createdAt])
  @@map("messages")
}

/// Edit history. The displayed message is marked edited; every prior body stays.
model MessageVersion {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  body       String   @db.Text
  replacedAt DateTime @default(now()) @map("replaced_at") @db.Timestamptz(6)

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, replacedAt])
  @@map("message_versions")
}

model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null between signing the upload and sending the message it belongs to.
  /// Attaching at send time means a 20 MB video uploading over 3G does not
  /// leave an empty bubble sitting in a child's conversation meanwhile.
  messageId   String?  @map("message_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(300)
  storageKey  String   @map("storage_key") @db.VarChar(500)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  sizeBytes   Int      @map("size_bytes")
  /// FR-FIL-001: quarantined until it passes, and the uploader is told.
  scanStatus  String   @default("pending") @map("scan_status") @db.VarChar(20)
  /// Voice notes carry a duration so the §5.3 cap is enforceable and the
  /// recipient sees the cost before playing it (NFR-BAN-002).
  durationSec Int?     @map("duration_sec")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}
